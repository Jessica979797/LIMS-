<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <style>
    * { box-sizing: border-box; }
    body { font-family: "Microsoft YaHei", "SimSun", sans-serif; color: #222; font-size: 12px; margin: 0; }
    .wrap { padding: 8px 10px; }
    h1 { font-size: 20px; text-align: center; margin: 0 0 4px; letter-spacing: 4px; }
    .sub { text-align: center; color: #666; margin-bottom: 14px; }
    table { width: 100%; border-collapse: collapse; margin: 6px 0; }
    th, td { border: 1px solid #999; padding: 5px 8px; text-align: left; }
    th { background: #f0f2f5; }
    .meta td { border: none; padding: 2px 8px 2px 0; }
    .section { margin-top: 12px; }
    .section-title { font-weight: bold; border-left: 3px solid #1677ff; padding-left: 6px; margin-bottom: 6px; }
    .conclusion { background: #f6ffed; border: 1px solid #b7eb8f; padding: 8px 12px; margin: 8px 0; }
    .signoff { margin-top: 28px; display: flex; justify-content: space-between; }
    .signoff div { text-align: center; width: 30%; }
    .signoff .role { font-weight: bold; margin-bottom: 26px; }
    .signoff .name { border-bottom: 1px solid #999; height: 20px; }
    .signoff .date { color: #666; margin-top: 4px; font-size: 11px; }
    .footer { margin-top: 26px; text-align: center; color: #999; font-size: 10px; border-top: 1px solid #eee; padding-top: 6px; }
  </style>
</head>
<body>
  <div class="wrap">
    <h1>检 测 报 告</h1>
    <div class="sub">报告编号：<%= reportNo %>　　第 <%= version %> 版</div>

    <table class="meta">
      <tr>
        <td><b>委托编号：</b><%= applicationNo %></td>
        <td><b>检测类别：</b><%= category || '-' %></td>
      </tr>
      <tr>
        <td><b>委托客户：</b><%= customerName %></td>
        <td><b>签发日期：</b><%= issuedAt || '-' %></td>
      </tr>
    </table>

    <div class="section">
      <div class="section-title">样品信息</div>
      <table>
        <thead>
          <tr><th>样品编号</th><th>样品名称</th><th>型号/规格</th><th>批号</th><th>生产厂商</th><th>数量</th></tr>
        </thead>
        <tbody>
          <% samples.forEach(function(s){ %>
          <tr>
            <td><%= s.sampleNo %></td>
            <td><%= s.name %></td>
            <td><%= s.model || '-' %></td>
            <td><%= s.batchNo || '-' %></td>
            <td><%= s.manufacturer || '-' %></td>
            <td><%= s.quantity %><%= s.unit ? ' ' + s.unit : '' %></td>
          </tr>
          <% }); %>
          <% if (!samples.length) { %><tr><td colspan="6">无样品</td></tr><% } %>
        </tbody>
      </table>
    </div>

    <div class="section">
      <div class="section-title">检测结果</div>
      <table>
        <thead>
          <tr><th>检测项目</th><th>检测方法</th><th>检测值</th><th>单位</th><th>标准限值</th><th>结论</th></tr>
        </thead>
        <tbody>
          <% results.forEach(function(r){ %>
          <tr>
            <td><%= r.itemName %></td>
            <td><%= r.method || '-' %></td>
            <td><%= r.value || '-' %></td>
            <td><%= r.unit || '-' %></td>
            <td><%= r.limit || '-' %></td>
            <td><%= r.conclusion %></td>
          </tr>
          <% }); %>
          <% if (!results.length) { %><tr><td colspan="6">无检测结果</td></tr><% } %>
        </tbody>
      </table>
    </div>

    <% if (conclusion) { %>
    <div class="section">
      <div class="section-title">总结论</div>
      <div class="conclusion"><%= conclusion %></div>
    </div>
    <% } %>

    <div class="signoff">
      <div>
        <div class="role">编制</div>
        <div class="name"><%= signoffs.prepare.name || '' %></div>
        <div class="date"><%= signoffs.prepare.at || '' %></div>
      </div>
      <div>
        <div class="role">审核</div>
        <div class="name"><%= signoffs.review.name || '' %></div>
        <div class="date"><%= signoffs.review.at || '' %></div>
      </div>
      <div>
        <div class="role">批准</div>
        <div class="name"><%= signoffs.approve.name || '' %></div>
        <div class="date"><%= signoffs.approve.at || '' %></div>
      </div>
    </div>

    <div class="footer">本报告未加盖检验检测专用章无效；报告内容以签发版本为准。</div>
  </div>
</body>
</html>
